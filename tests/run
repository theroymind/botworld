#!/bin/sh
# Run the economy spec with the first available Lua interpreter.
set -e
cd "$(dirname "$0")/.."
for interpreter in lua5.1 luajit lua texlua; do
  if command -v "$interpreter" >/dev/null 2>&1; then
    exec "$interpreter" tests/economy_spec.lua
  fi
done
echo "tests/run: no lua interpreter found (tried lua5.1, luajit, lua, texlua)" >&2
exit 1
